# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=3000
RUST_LOG=dsa=debug,tower_http=debug,axum::rejection=trace

# ---------------------------------------------------------------------------
# Database (REQUIRED — app panics at startup if missing)
# ---------------------------------------------------------------------------
DATABASE_URL=your-database-connection-string

TEST_DATABASE_URL=

# Connection pool tuning
DB_MAX_CONNECTIONS=5
DB_MIN_CONNECTIONS=1
DB_ACQUIRE_SLOW_THRESHOLD=2
# Bounds how long the pool waits for a connection (and while opening one to an
# unreachable DB) so the server fails fast instead of hanging. Seconds.
DB_ACQUIRE_TIMEOUT=10

# ---------------------------------------------------------------------------
# Redis (cache + rate limiter). Defaults to redis://127.0.0.1:6379 if omitted.
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# JWT (all have safe defaults; override in production!)
# ---------------------------------------------------------------------------
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ISSUER=splitdebt-api
JWT_AUDIENCE=splitdebt-client

# ---------------------------------------------------------------------------
# Google OAuth (optional — only needed for Google login)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/users/auth/google/callback

# ---------------------------------------------------------------------------
# Argon2 password hashing (optional — sensible Argon2id defaults)
# ---------------------------------------------------------------------------
ARGON2_M_COST=19456
ARGON2_T_COST=2
ARGON2_P_COST=1
ARGON2_OUTPUT_LEN=32

# ---------------------------------------------------------------------------
# Email SMTP (Gmail App Password). Bỏ trống USERNAME/PASSWORD để tắt gửi mail.
# App Password cần bật 2-Step Verification; Gmail giới hạn ~500 mail/ngày.
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM=you@gmail.com

# ---------------------------------------------------------------------------
# Email verification bypass (dev/test only).
# true/1 => bỏ qua đối chiếu OTP ở signup + forgot-password (field `otp`
# vẫn nhận nhưng bị ignore). Mặc định tắt. CẤM bật ở production:
# APP_ENV=production + SKIP=true => app fail-fast lúc boot, không start.
# ---------------------------------------------------------------------------
SKIP_EMAIL_VERIFICATION=false
# APP_ENV=development

# ---------------------------------------------------------------------------
# CORS (frontend origin). Defaults to http://localhost:5173 if omitted.
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Cookies (refresh token). Set true khi serve qua HTTPS ở production để browser
# chỉ gửi cookie qua TLS. Dev HTTP giữ false (true sẽ làm cookie không được set).
# ---------------------------------------------------------------------------
COOKIE_SECURE=false
